# Server-side Supabase configuration.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the Android app or clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Secret used to sign login tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Never commit the real value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters

# Browsers the website may be served from (comma-separated). The defaults cover
# the local web dev server; set this to your real site URL when you deploy it.
# CORS_ALLOW_ORIGINS=https://your-site.example.com

# OpenAI key used for receipt/statement reading and the AI insights.
OPENAI_API_KEY=replace-with-your-openai-api-key

# ── Email (verification and password-reset codes) ────────────────────────────
# Leave SMTP_HOST empty in development: the code is printed in the backend's log
# instead of being emailed. For real mail use any SMTP provider (Gmail app
# password, SendGrid, Brevo, Resend, Mailgun, ...). Port 465 uses implicit SSL,
# anything else uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=HissabAI <no-reply@your-domain.example>

# Email verification is required before an account can use its data. Set to false
# ONLY for local development without email.
# REQUIRE_EMAIL_VERIFICATION=false

# Set to true only when the backend sits behind a reverse proxy you control, so the
# rate limiter sees the real client address (X-Forwarded-For).
# TRUST_PROXY_HEADERS=true

# The vision model double-checks the document type when the image heuristics are
# unsure (one extra small call per auto-detected upload). Set to off to disable.
# AI_CLASSIFIER=off

