# HissabAI settings. Copy this file to .env (project root) and edit it; the backend
# reads it automatically. Empty values and "replace-with-..." placeholders are ignored.
#
# The only required value is OPENAI_API_KEY (it reads documents and writes the AI
# text). The database is a local SQLite file by default, so nothing else is needed.

# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-your-openai-api-key

# ── Database (optional) ───────────────────────────────────────────────────────
# Default: a SQLite file at backend/data/hissabai.db. To change its location:
# HISSABAI_DB_PATH=/path/to/hissabai.db
#
# To use Supabase (hosted Postgres) instead, run the SQL in supabase/migrations/
# and uncomment these. Never expose the service-role key to the apps.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STORAGE_BACKEND=supabase   # or sqlite; default: Supabase only if SUPABASE_URL is set

# ── Login tokens (optional) ───────────────────────────────────────────────────
# A random secret is generated and kept in backend/data/jwt_secret if this is not
# set. Set your own when you deploy (changing it signs everyone out):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_JWT_SECRET=

# ── Website (optional) ────────────────────────────────────────────────────────
# Browsers the website may be served from (comma-separated). The defaults cover
# the local dev server; set this to your real site URL when you deploy it.
# CORS_ALLOW_ORIGINS=https://your-site.example.com

# ── Email: verification and password-reset codes (optional in development) ────
# Leave SMTP_HOST empty in development: codes are printed in the backend console
# instead of being emailed. For real mail use any SMTP provider (Gmail app
# password, SendGrid, Brevo, Resend, Mailgun, ...). Port 465 uses implicit SSL,
# anything else uses STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=HissabAI <no-reply@your-domain.example>

# Email verification is required before an account can use its data. Set to false
# ONLY for local development without email.
# REQUIRE_EMAIL_VERIFICATION=false

# Set to true only behind a reverse proxy you control, so the rate limiter sees
# the real client address (X-Forwarded-For).
# TRUST_PROXY_HEADERS=true

# The vision model double-checks the document type when the image heuristics are
# unsure (one extra small call per auto-detected upload). Set to off to disable.
# AI_CLASSIFIER=off
