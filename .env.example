# Server-side Supabase configuration.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the Android app or clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Secret used to sign login tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Never commit the real value.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
